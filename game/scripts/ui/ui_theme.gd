class_name UITheme
extends RefCounted
## Single UI theme (res://assets/ui/theme.tres, generated by build_theme.gd) + shared palette and widget helpers.

const THEME_PATH: String = "res://assets/ui/theme.tres"
const BG: Color = Color(0.04, 0.05, 0.07, 0.80)
const BG_SOLID: Color = Color(0.05, 0.06, 0.08, 1.0)
const PANEL_EDGE: Color = Color(1.0, 1.0, 1.0, 0.10)
const ACCENT: Color = Color(1.0, 0.74, 0.16)
const ACCENT_DIM: Color = Color(0.78, 0.54, 0.10)
const TEXT: Color = Color(0.93, 0.93, 0.96)
const TEXT_DIM: Color = Color(0.62, 0.64, 0.70)
const DANGER: Color = Color(0.92, 0.20, 0.18)
const OK: Color = Color(0.45, 0.85, 0.40)

static var _cached: Theme = null


static func get_theme() -> Theme:
	if _cached == null:
		var t: Theme = null
		if ResourceLoader.exists(THEME_PATH):
			t = load(THEME_PATH) as Theme
		_cached = t if t != null else build()
	return _cached


static func box(bg: Color, edge: Color = Color(0, 0, 0, 0), radius: int = 8, border: int = 0, pad: Vector2 = Vector2(14, 8)) -> StyleBoxFlat:
	var s: StyleBoxFlat = StyleBoxFlat.new()
	s.bg_color = bg
	s.set_corner_radius_all(radius)
	s.border_color = edge
	s.set_border_width_all(border)
	s.content_margin_left = pad.x
	s.content_margin_right = pad.x
	s.content_margin_top = pad.y
	s.content_margin_bottom = pad.y
	s.anti_aliasing = true
	return s


static func _dot(d: int, c: Color) -> ImageTexture:
	var img: Image = Image.create(d, d, false, Image.FORMAT_RGBA8)
	var r: float = d * 0.5
	for y: int in d:
		for x: int in d:
			var dist: float = Vector2(x + 0.5, y + 0.5).distance_to(Vector2(r, r))
			img.set_pixel(x, y, Color(c.r, c.g, c.b, clampf(r - dist, 0.0, 1.0)))
	return ImageTexture.create_from_image(img)


static func _check(d: int, on: bool) -> ImageTexture:
	var img: Image = Image.create(d, d, false, Image.FORMAT_RGBA8)
	for y: int in d:
		for x: int in d:
			var ex: float = minf(minf(x + 0.5, d - x - 0.5), minf(y + 0.5, d - y - 0.5))
			var corner: float = clampf(ex, 0.0, 1.0)
			var c: Color = Color(0, 0, 0, 0)
			if on:
				c = Color(ACCENT.r, ACCENT.g, ACCENT.b, corner)
				var inner: float = 1.0 if (x > d * 0.3 and x < d * 0.7 and y > d * 0.3 and y < d * 0.7) else 0.0
				c = c.lerp(Color(0.05, 0.05, 0.06, 1.0), inner)
			else:
				var edge: float = 1.0 if ex < 2.0 else 0.0
				c = Color(1, 1, 1, corner * (0.10 + 0.55 * edge))
			img.set_pixel(x, y, c)
	return ImageTexture.create_from_image(img)


static func build() -> Theme:
	var t: Theme = Theme.new()
	var f: SystemFont = SystemFont.new()
	f.font_names = PackedStringArray(["Inter", "Noto Sans", "DejaVu Sans", "Sans-Serif"])
	f.antialiasing = TextServer.FONT_ANTIALIASING_LCD if false else TextServer.FONT_ANTIALIASING_GRAY
	f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_AUTO
	t.default_font = f
	t.default_font_size = 20
	# Label
	t.set_color("font_color", "Label", TEXT)
	t.set_color("font_shadow_color", "Label", Color(0, 0, 0, 0.55))
	t.set_constant("shadow_offset_x", "Label", 1)
	t.set_constant("shadow_offset_y", "Label", 2)
	# Panels
	t.set_stylebox("panel", "PanelContainer", box(BG, PANEL_EDGE, 12, 1, Vector2(22, 18)))
	t.set_stylebox("panel", "Panel", box(BG, PANEL_EDGE, 12, 1))
	# Buttons
	t.set_stylebox("normal", "Button", box(Color(1, 1, 1, 0.06), PANEL_EDGE, 8, 1, Vector2(18, 9)))
	t.set_stylebox("hover", "Button", box(Color(1.0, 0.74, 0.16, 0.20), ACCENT_DIM, 8, 1, Vector2(18, 9)))
	t.set_stylebox("pressed", "Button", box(Color(1.0, 0.74, 0.16, 0.38), ACCENT, 8, 1, Vector2(18, 9)))
	t.set_stylebox("focus", "Button", box(Color(1.0, 0.74, 0.16, 0.14), ACCENT, 8, 2, Vector2(18, 9)))
	t.set_stylebox("disabled", "Button", box(Color(1, 1, 1, 0.02), Color(1, 1, 1, 0.05), 8, 1, Vector2(18, 9)))
	t.set_color("font_color", "Button", TEXT)
	t.set_color("font_hover_color", "Button", Color.WHITE)
	t.set_color("font_focus_color", "Button", ACCENT)
	t.set_color("font_pressed_color", "Button", ACCENT)
	t.set_color("font_disabled_color", "Button", Color(1, 1, 1, 0.3))
	for tn: String in ["OptionButton", "CheckBox"]:
		for sn: String in ["normal", "hover", "pressed", "focus", "disabled"]:
			if tn == "OptionButton":
				t.set_stylebox(sn, tn, t.get_stylebox(sn, "Button"))
		t.set_color("font_color", tn, TEXT)
		t.set_color("font_hover_color", tn, Color.WHITE)
		t.set_color("font_focus_color", tn, ACCENT)
		t.set_color("font_pressed_color", tn, TEXT)
	for sn: String in ["normal", "hover", "pressed", "focus", "disabled", "hover_pressed"]:
		t.set_stylebox(sn, "CheckBox", StyleBoxEmpty.new())
	for ic: String in ["checked", "checked_disabled"]:
		t.set_icon(ic, "CheckBox", _check(24, true))
	for ic: String in ["unchecked", "unchecked_disabled"]:
		t.set_icon(ic, "CheckBox", _check(24, false))
	t.set_constant("h_separation", "CheckBox", 10)
	t.set_stylebox("panel", "PopupMenu", box(BG_SOLID, PANEL_EDGE, 8, 1, Vector2(8, 6)))
	t.set_stylebox("hover", "PopupMenu", box(Color(1.0, 0.74, 0.16, 0.25), Color(0, 0, 0, 0), 4, 0, Vector2(8, 4)))
	# Sliders
	var track: StyleBoxFlat = box(Color(1, 1, 1, 0.12), Color(0, 0, 0, 0), 4, 0, Vector2(0, 3))
	var fill: StyleBoxFlat = box(ACCENT, Color(0, 0, 0, 0), 4, 0, Vector2(0, 3))
	t.set_stylebox("slider", "HSlider", track)
	t.set_stylebox("grabber_area", "HSlider", fill)
	t.set_stylebox("grabber_area_highlight", "HSlider", fill)
	t.set_icon("grabber", "HSlider", _dot(20, TEXT))
	t.set_icon("grabber_highlight", "HSlider", _dot(20, ACCENT))
	t.set_icon("grabber_disabled", "HSlider", _dot(20, TEXT_DIM))
	# Tabs
	t.set_stylebox("tab_selected", "TabContainer", box(Color(1.0, 0.74, 0.16, 0.22), ACCENT_DIM, 8, 1, Vector2(18, 8)))
	t.set_stylebox("tab_unselected", "TabContainer", box(Color(1, 1, 1, 0.04), Color(0, 0, 0, 0), 8, 0, Vector2(18, 8)))
	t.set_stylebox("tab_hovered", "TabContainer", box(Color(1, 1, 1, 0.10), Color(0, 0, 0, 0), 8, 0, Vector2(18, 8)))
	t.set_stylebox("tab_focus", "TabContainer", StyleBoxEmpty.new())
	t.set_stylebox("panel", "TabContainer", box(Color(0, 0, 0, 0), Color(0, 0, 0, 0), 0, 0, Vector2(6, 12)))
	t.set_color("font_selected_color", "TabContainer", ACCENT)
	t.set_color("font_unselected_color", "TabContainer", TEXT_DIM)
	t.set_color("font_hovered_color", "TabContainer", Color.WHITE)
	t.set_constant("separation", "VBoxContainer", 10)
	t.set_constant("separation", "HBoxContainer", 12)
	return t


# ───────────── widget helpers ─────────────
static func label(text: String, size: int = 20, color: Color = TEXT, align: int = HORIZONTAL_ALIGNMENT_LEFT) -> Label:
	var l: Label = Label.new()
	l.text = text
	l.horizontal_alignment = align as HorizontalAlignment
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", color)
	return l


static func button(text: String, cb: Callable, min_w: float = 280.0) -> Button:
	var b: Button = Button.new()
	b.text = text
	b.custom_minimum_size = Vector2(min_w, 46)
	b.pressed.connect(cb)
	b.focus_entered.connect(func() -> void: ui_sfx("menu_move"))
	return b


static func ui_sfx(sound: String) -> void:
	if Engine.get_main_loop() == null:
		return
	var ev: Node = (Engine.get_main_loop() as SceneTree).root.get_node_or_null("Events")
	if ev != null and ev.has_signal("sfx"):
		ev.emit_signal("sfx", sound, Vector3.INF)


static func fmt_time(seconds: float) -> String:
	var s: int = int(seconds)
	return "%d:%02d" % [s / 60, s % 60]
